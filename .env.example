# --- Supabase (Project settings → API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # the "service_role" secret key, NOT the anon key

# --- Anthropic (used by pipeline/02_enrich.py and the in-app "Ask tutor") ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5          # cheaper alternative: claude-haiku-4-5-20251001
ENRICH_CONCURRENCY=4

# --- Narration voice (edge-tts, free; list options with: python pipeline/03_audio.py --voices) ---
TTS_VOICE=en-US-AvaMultilingualNeural
TTS_RATE=-4%
TTS_CONCURRENCY=4

# --- Exam format (change only if the Motorizzazione format changes) ---
EXAM_SIZE=30
EXAM_MINUTES=20
EXAM_MAX_ERRORS=3
